# ── Required in production ─────────────────────────────
# Postgres connection string (Vercel Postgres / Neon / Supabase).
# Leave empty locally to use the built-in embedded database (.pglite/).
DATABASE_URL=

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Resend (https://resend.com) for OTP emails. Leave empty locally: codes print in the terminal.
RESEND_API_KEY=
EMAIL_FROM="Suinance <no-reply@your-domain.com>"

# Public site URL, used in links and metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Optional ───────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_MEDIUM=
# Override Sui endpoints if you use a private RPC provider
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
